# 复制为 .env（已被 .gitignore 的 *.env 规则忽略，永不入库）后填入真实 key。
# 冒烟：node --env-file=deploy/layers/qm-cn/.env deploy/layers/qm-cn/scripts/provider-smoke.mjs deploy/layers/qm-cn/providers/deepseek.json
# 导入：node --env-file=deploy/layers/qm-cn/.env deploy/layers/qm-cn/providers/import.mjs deepseek

# 模型供应商（先填这两家跑冒烟）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# 其余供应商（按需填写）
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=

# OpenRouter 中转（openrouter-free，可选）
OPENROUTER_TEST_KEY=

# 导入到运行中的核心时需要（冒烟不需要）
# CORE_URL=http://127.0.0.1:4141
# CORE_SIGNING_SECRET=
